# Copy this file to .env for the local Docker parity stack, then replace both
# CHANGE_ME values with the same URL-encoded, randomly generated password.
# Never commit the resulting .env file.
POSTGRES_DB=sl3dge
POSTGRES_USER=sl3dge
POSTGRES_PASSWORD=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432

ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://sl3dge:CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS@postgres:5432/sl3dge
MIGRATION_DATABASE_URL=postgresql+psycopg://sl3dge:CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS@postgres:5432/sl3dge
DATABASE_DISABLE_PREPARED_STATEMENTS=false

BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_MODE=demo
NEXT_PUBLIC_AUTH_MODE=disabled
NEXT_PUBLIC_OIDC_AUTHORITY=
NEXT_PUBLIC_OIDC_CLIENT_ID=
NEXT_PUBLIC_OIDC_AUDIENCE=
NEXT_PUBLIC_OIDC_SCOPE=openid profile email

# Optional local integrations. Keep every secret blank until it is needed.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=sl3dge-private
GROQ_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=1200
LLM_MAX_INPUT_CHARS=24000
AGENT_MAX_ATTEMPTS=2
AGENT_CHECKPOINT_DATABASE_URL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_MODE=test
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_TIMEOUT_SECONDS=20
RAZORPAY_MAX_RETRIES=3
RAZORPAY_MAX_PAGES=100
RAZORPAY_MAX_RECORDS=100000
RAZORPAY_MAX_RESPONSE_BYTES=10485760
WORKER_TENANT_IDS=novacart_demo
WORKER_LEASE_SECONDS=900
WORKER_POLL_SECONDS=2
RAZORPAY_MCP_ENABLED=false
