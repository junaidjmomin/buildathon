# Local fallback. Override both URLs with Supabase Postgres connection strings
# in deployed environments (runtime pooler for DATABASE_URL, direct/session for migrations).
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://sl3dge:sl3dge@localhost:5432/sl3dge
MIGRATION_DATABASE_URL=postgresql+psycopg://sl3dge:sl3dge@localhost:5432/sl3dge
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
# Disable driver-prepared statements for Supabase transaction-mode pooler compatibility.
DATABASE_DISABLE_PREPARED_STATEMENTS=true
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=sl3dge-private

# Only NEXT_PUBLIC_* values are safe to expose to the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_MODE=demo
NEXT_PUBLIC_AUTH_MODE=disabled
NEXT_PUBLIC_OIDC_AUTHORITY=
NEXT_PUBLIC_OIDC_CLIENT_ID=
NEXT_PUBLIC_OIDC_AUDIENCE=
NEXT_PUBLIC_OIDC_SCOPE=openid profile email

DEMO_SEED=20260825
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_HOSTS=localhost,127.0.0.1
FORCE_HTTPS=false
MAX_UPLOAD_BYTES=10485760
MAX_AGREEMENT_PAGES=200
MAX_PDF_PAGE_CONTENT_BYTES=5242880
MAX_EXTRACTED_AGREEMENT_CHARS=500000

# Local-only default. Production startup fails unless OIDC is configured.
AUTH_MODE=disabled
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_TENANT_CLAIM=merchant_id
OIDC_ROLES_CLAIM=roles

LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=1200
LLM_MAX_INPUT_CHARS=24000
AGENT_MAX_ATTEMPTS=2
# Private backend-only Postgres DSN for durable LangGraph checkpoints in deployed environments.
AGENT_CHECKPOINT_DATABASE_URL=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_MODE=test
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_TIMEOUT_SECONDS=20
RAZORPAY_MAX_RETRIES=3
RAZORPAY_MAX_PAGES=100
RAZORPAY_MAX_RECORDS=100000
RAZORPAY_MAX_RESPONSE_BYTES=10485760
RAZORPAY_MCP_ENABLED=false

WORKER_TENANT_IDS=novacart_demo
WORKER_LEASE_SECONDS=900
WORKER_POLL_SECONDS=2
