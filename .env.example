# Local fallback. Override both URLs with Supabase Postgres connection strings
# in deployed environments (runtime pooler for DATABASE_URL, direct/session for migrations).
DATABASE_URL=postgresql+psycopg://sl3dge:sl3dge@localhost:5432/sl3dge
MIGRATION_DATABASE_URL=postgresql+psycopg://sl3dge:sl3dge@localhost:5432/sl3dge
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
# Disable driver-prepared statements for Supabase transaction-mode pooler compatibility.
DATABASE_DISABLE_PREPARED_STATEMENTS=true
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=sl3dge-private
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
DEMO_SEED=20260825
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# Backend-only. Never expose through NEXT_PUBLIC_*.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_MODE=test
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_MCP_ENABLED=false
